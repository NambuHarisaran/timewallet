rules_version = '2';

// TimeWallet — each user can only touch their own document tree, AND every
// write must match the expected shape/range/size. Unlisted paths are denied
// (fail closed). Deletes carry no payload so they validate on ownership only.
service cloud.firestore {
  match /databases/{database}/documents {

    // Ownership + verified email. Password accounts must have a verified
    // email (the app gates this in UI, but rules must enforce it too — S4);
    // Google/other federated providers arrive pre-verified.
    function owner(userId) {
      return request.auth != null
          && request.auth.uid == userId
          && (request.auth.token.firebase.sign_in_provider != 'password'
              || request.auth.token.email_verified == true);
    }
    function strOk(v, max) {
      return v is string && v.size() <= max;
    }
    // Upper bound blocks absurd magnitudes (1e308 etc.) that would corrupt
    // aggregates and charts; 1e11 is far beyond any real amount/minutes (S11).
    function numOk(v) {
      return v is number && v >= 0 && v <= 100000000000;
    }
    function intIn(v, lo, hi) {
      return v is int && v >= lo && v <= hi;
    }

    match /users/{userId} {
      // Profile document.
      allow read: if owner(userId);
      allow write: if owner(userId)
                   && request.resource.data.size() <= 24
                   && strOk(request.resource.data.name, 80);

      match /expenses/{id} {
        allow read, delete: if owner(userId);
        allow write: if owner(userId)
          && request.resource.data.size() <= 12
          && numOk(request.resource.data.amount)
          && intIn(request.resource.data.mood, 0, 2)
          && intIn(request.resource.data.needWant, 0, 1)
          && numOk(request.resource.data.timeCostMinutes)
          && strOk(request.resource.data.categoryId, 40);
      }

      match /goals/{id} {
        allow read, delete: if owner(userId);
        allow write: if owner(userId)
          && request.resource.data.size() <= 10
          && numOk(request.resource.data.amount)
          && numOk(request.resource.data.savedAmount)
          && strOk(request.resource.data.title, 100)
          && strOk(request.resource.data.emoji, 12);
      }

      match /holdings/{id} {
        allow read, delete: if owner(userId);
        allow write: if owner(userId)
          && request.resource.data.size() <= 14
          // 0..3 leaves room for the planned mutualFund asset type.
          && intIn(request.resource.data.type, 0, 3)
          && numOk(request.resource.data.units)
          && numOk(request.resource.data.buyPrice)
          && strOk(request.resource.data.name, 80);
      }

      match /activity/{id} {
        allow read, delete: if owner(userId);
        allow write: if owner(userId)
          && request.resource.data.size() <= 10
          // ActivityType enum currently has 14 values; 0..31 leaves headroom
          // for new types without a rules redeploy (S11).
          && intIn(request.resource.data.type, 0, 31)
          && strOk(request.resource.data.title, 160);
      }

      match /budgets/{id} {
        allow read, delete: if owner(userId);
        allow write: if owner(userId)
          && request.resource.data.size() <= 4
          && strOk(request.resource.data.categoryId, 40)
          && numOk(request.resource.data.monthlyLimit);
      }

      match /recurring/{id} {
        allow read, delete: if owner(userId);
        allow write: if owner(userId)
          && request.resource.data.size() <= 8
          && strOk(request.resource.data.name, 80)
          && numOk(request.resource.data.amount)
          && intIn(request.resource.data.cycle, 0, 2)
          && strOk(request.resource.data.categoryId, 40);
      }

      // Per-user state docs — enumerated, shape-checked (S3). 'worked' is a
      // map of day-key → minutes (size-capped ≈ 2 years of days); 'stats'
      // holds small counters. Unknown doc IDs are denied (fail closed).
      match /state/{doc} {
        allow read, delete: if owner(userId);
        allow write: if owner(userId)
          && (
            (doc == 'worked' && request.resource.data.size() <= 800)
            || (doc == 'stats'
                && request.resource.data.size() <= 8
                && numOk(request.resource.data.reclaimedMinutes))
          );
      }
    }
  }
}
